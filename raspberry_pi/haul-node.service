[Unit]
Description=Haul Fleet Pi telemetry node
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/raspberry_pi
Environment=HAUL_SERVER=http://192.168.1.50:5000
Environment=HAUL_VEHICLE=TRUCK_01
ExecStart=/home/pi/raspberry_pi/venv/bin/python pi_node.py --lidar tfluna --imu --camera
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
